# Variáveis de ambiente do projeto Financeiro — copie para .env e preencha
# NUNCA commitar o .env (já está no .gitignore)

# Banco de dados (MySQL local)
DB_USERNAME=
DB_PASSWORD=

# JWT — gere um segredo com: openssl rand -base64 48
JWT_SECRET=

# E-mail (opcional — só necessário pra testar recuperação de senha e lembrete de conta fixa)
MAIL_USERNAME=
MAIL_PASSWORD=
